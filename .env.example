# Copie este arquivo para ".env" e preencha os valores antes de rodar o servidor.
# NUNCA cometa o arquivo ".env" de verdade no git (ele já está no .gitignore).

# Porta em que o servidor vai rodar
PORT=3000

# Ambiente: "development" ou "production"
NODE_ENV=development

# Segredo usado para assinar os tokens de sessão (JWT).
# Gere um valor aleatório forte, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-valor-aleatorio-bem-grande

# Chave de API da Anthropic, usada apenas pelo servidor para a Conselheira IA.
# Nunca é exposta ao navegador do cliente.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Origem do frontend, se ele for hospedado separadamente do backend (CORS).
# Se frontend e backend forem servidos juntos (recomendado aqui), pode deixar em branco.
ALLOWED_ORIGIN=

# E-mail (Gmail SMTP) usado para o link de "esqueci minha senha".
# GMAIL_APP_PASSWORD é gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta Gmail).
# Em desenvolvimento, se ficar em branco, o link é só impresso no console
# do servidor em vez de enviado de verdade.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL pública do app, usada para montar o link de redefinição enviado por
# e-mail. Em produção, use o domínio real (ex.: https://seuapp.com).
APP_BASE_URL=http://localhost:3000
